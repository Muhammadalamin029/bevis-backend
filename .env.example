# Bevis backend environment. Copy to .env and fill in secrets.
# Every key here maps to a BEVIS_* setting (see config/settings.py).
# Docker compose already sets the service wiring; these are for
# local runs and for values compose does not provide.

# --- App ---
BEVIS_ENVIRONMENT=development
BEVIS_API_PREFIX=/api

# --- Database (docker compose overrides this with Postgres) ---
BEVIS_DATABASE_URL=sqlite:///./bevis.db

# --- Postgres credentials (Docker only: read by docker-compose.yml,
# never by the app settings) ---
POSTGRES_USER=bevis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bevis

# --- Auth (override the secret in every real deployment) ---
BEVIS_JWT_SECRET_KEY=dev-secret-change-me-to-32-bytes-minimum
BEVIS_JWT_ALGORITHM=HS256
BEVIS_ACCESS_TOKEN_EXPIRE_MINUTES=60
BEVIS_REFRESH_TOKEN_EXPIRE_DAYS=30
BEVIS_RESET_TOKEN_EXPIRE_MINUTES=60

# --- First admin (empty = skip seeding) ---
BEVIS_ADMIN_EMAIL=
BEVIS_ADMIN_PASSWORD=

# --- Sessions + queue (docker compose overrides with the redis service) ---
BEVIS_REDIS_URL=redis://localhost:6379/0
BEVIS_CELERY_BROKER_URL=
BEVIS_CELERY_RESULT_BACKEND=

# --- Email via Sendlib (empty key = worker logs and skips sends) ---
BEVIS_SENDLIB_API_URL=https://sendlib.samueltuoyo.com/api/send
BEVIS_SENDLIB_API_KEY=
BEVIS_SENDLIB_FROM=
BEVIS_FRONTEND_URL=http://localhost:5173
BEVIS_EMAIL_MAX_RETRIES=5

# --- Cloudflare Turnstile (signup only; empty = verification off) ---
BEVIS_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
BEVIS_TURNSTILE_SECRET_KEY=
